+		// IntelAccelerator+0x1278 is the media-engine object. With video fuse 4 (this part
+		// reports 0xe00fb => video 4) VCS0/VECS0 are fused off, so that pointer stays null
+		// and the native body would fault on [0 + 0xb8]. Everything else stays native.
+		const auto media = *reinterpret_cast<void **>(static_cast<uint8_t *>(accel) + 0x1278);
