+			static uint32_t skipped {};
+			if (auto root = IORegistryEntry::getRegistryRoot())
+				root->setProperty("TGLPAVPUnavailable", __sync_add_and_fetch(&skipped, 1), 32);
+			return 0xe00002bc; // kIOReturnUnsupported; startGraphicsEngine ignores the value.
+		}
+	}
+	return FunctionCast(wrapTGLPAVPCommandCallback, callbackXE->orgTGLPAVPCommandCallback)(accel, command, arg, out, flag);
+}
