+  root->setProperty("TGLWEXDozeDCGuardReady",true);
+  root->setProperty("TGLWEXDozeDCGuardHits",count,32);
+ }
+ SYSLOG("igfx","TGL DC guard: keep power well alive, skip DC arming in Doze (count=%u)",count);
+}
