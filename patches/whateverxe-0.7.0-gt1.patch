+  IORegistryEntry::getRegistryRoot()->setProperty("TGLPanelPowerOffSkipped",__sync_add_and_fetch(&skipped,1),32);
+  return 0;
+ }
+ return FunctionCast(wrapTGLPanelPower,s->orgTGLPanelPower)(controller,state);
+}
 
+bool XE::tglFBDozeActive() {
+ auto s=callbackXE;
+ for(unsigned i=0;i<arrsize(s->tglFBKeys);++i)
+  if(s->tglFBKeys[i] && s->tglFBStates[i]==1) return true;
+ return false;
+}
+
+void XE::wrapTGLFBSetPowerState(void *fb,uint32_t state) {
+ auto s=callbackXE;
+ // Record the new state *before* the native body runs: the native transition is what calls
+ // disableDisplay / setDCState, and both guards key off this table. Recording afterwards
+ // would make every guard look at the previous state and miss the transition entirely.
+ if(fb){
+  for(unsigned i=0;i<arrsize(s->tglFBKeys);++i){
+   if(s->tglFBKeys[i]==fb) { s->tglFBStates[i]=state; break; }
+   if(!s->tglFBKeys[i]) { s->tglFBKeys[i]=fb; s->tglFBStates[i]=state; break; }
+  }
+ }
+ FunctionCast(wrapTGLFBSetPowerState,s->orgTGLFBSetPowerState)(fb,state);
+ if(!fb) return;
+ if(auto root=IORegistryEntry::getRegistryRoot()){
+  root->setProperty("TGLWEXFBStateRouted",true);
+  root->setProperty("TGLWEXFBStateLast",state,32);
+  root->setProperty("TGLWEXFBDoze",tglFBDozeActive());
+ }
+ SYSLOG("igfx","TGL DC guard: framebuffer %p power state -> %u",fb,state);
+}
+
+void XE::wrapTGLSetDCState(void *controller,bool enable) {
+ auto s=callbackXE;
+ const auto org=FunctionCast(wrapTGLSetDCState,s->orgTGLSetDCState);
+ // Only the Doze transition is dangerous: that is the one whose DC exit can fail.
